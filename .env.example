# ShortenIt API — environment configuration
# Copy this file to .env and adjust the values for your local setup.
#   cp .env.example .env

# PostgreSQL — local dev (individual fields)
# To use Neon (or any Postgres URL), set DATABASE_URL instead and leave the fields below empty.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortner_db
DB_PORT=5432

# Redis — local dev (individual fields)
# To use Upstash TCP, set REDIS_URL instead and leave the fields below empty.
# REDIS_URL=rediss://default:password@host:port
REDIS_ADDR=localhost:6379
REDIS_PASS=
REDIS_DB=0
REDIS_PROTOCOL=3
REDIS_EXP_IN_SECONDS=86400
REDIS_MAX_IDLE_CONNS=10
REDIS_MAX_ACTIVE_CONNS=100

# Domain used in generated short URLs (no scheme).
# For local dev leave it as localhost:8080.
# On Render, set this to your Render service URL (e.g. my-api.onrender.com).
DOMAIN_NAME=localhost:8080

# Port the server listens on.
# Render injects $PORT automatically — do not override it there.
PORT=8080
