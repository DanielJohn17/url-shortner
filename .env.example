# ShortenIt API — environment configuration
# Copy this file to .env and adjust the values for your local setup.
#   cp .env.example .env

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortner_db
DB_PORT=5432

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASS=""
REDIS_DB=0
REDIS_PROTOCOL=3
REDIS_EXP_IN_SECONDS=86400
REDIS_MAX_IDLE_CONNS=10
REDIS_MAX_ACTIVE_CONNS=100

# Domain used in generated short URLs (no scheme).
# For local dev leave it as localhost:8080.
D_NAME=localhost:8080
