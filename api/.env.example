# ShortenIt — API environment configuration
# Copy this file to api/.env and fill in your values.
#   cp api/.env.example api/.env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Option A · Neon (or any Postgres URL) — set DATABASE_URL, leave DB_* blank.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Option B · Local Postgres (individual fields)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortner_db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
# Option A · Upstash TCP URL — set REDIS_URL, leave REDIS_* blank.
# REDIS_URL=rediss://default:password@host:port

# Option B · Local Redis (individual fields)
REDIS_ADDR=localhost:6379
REDIS_PASS=
REDIS_DB=0
REDIS_PROTOCOL=3
REDIS_EXP_IN_SECONDS=86400
REDIS_MAX_IDLE_CONNS=10
REDIS_MAX_ACTIVE_CONNS=100

# ── App ───────────────────────────────────────────────────────────────────────
# Domain included in generated short URLs (no scheme).
# Local dev: localhost:8080 · Render: your-service.onrender.com
DOMAIN_NAME=localhost:8080

# Port the server listens on.
# Render injects $PORT automatically — do NOT set it on Render.
PORT=8080
