# ShortenIt — Web environment configuration
# Copy this file to web/.env and fill in your values.
#   cp web/.env.example web/.env

# ── API Base URL ─────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash).
# Local dev: leave empty — Vite's proxy forwards /api → localhost:8080.
# Vercel: set this to your Render service URL in Vercel's Environment Variables.
VITE_API_URL=
